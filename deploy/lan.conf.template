server {
    listen ${TASK_HUB_LAN_IP}:${TASK_HUB_LAN_PORT};
    server_name _;
    server_tokens off;
    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:${TASK_HUB_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        # Replace client-supplied forwarding headers before the trusted backend.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header Connection "";
        # HTTP sessions work on the LAN; Tailscale keeps its Secure cookies.
        proxy_cookie_flags homelab_session nosecure;
        proxy_buffering off;
    }
}
